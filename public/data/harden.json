om Brooklyn.","teams":["HOU","MIA"],"moves":[{"asset":"oladipo","from":"HOU","to":"MIA"},{"asset":"olynyk","from":"MIA","to":"HOU"},{"asset":"bradley-avery","from":"MIA","to":"HOU"},{"asset":"mia22-oladipo-swap","from":"MIA","to":"HOU"}],"conversions":[],"resolutions":[],"sources":["harden21-full"],"notes":[],"verified":"verified","reviewed":"2026-09-08"},{"id":"levert-cleveland","date":"2022-02-07","order":0,"kind":"trade","title":"LeVert becomes three draft paths.","shortTitle":"LeVert goes to Cleveland","text":"Cleveland adds LeVert and a Miami second. Indiana receives Rubio, a protected first and two seconds.","teams":["IND","CLE"],"moves":[{"asset":"levert","from":"IND","to":"CLE"},{"asset":"mia22-second","from":"IND","to":"CLE"},{"asset":"rubio","from":"CLE","to":"IND"},{"asset":"cle22-levert","from":"CLE","to":"IND"},{"asset":"hou22-second","from":"CLE","to":"IND"},{"asset":"uta27-second","from":"CLE","to":"IND"}],"conversions":[],"resolutions":[],"sources":["levert22","levert22-summary","levert22-protection"],"notes":["February 7 is the official acquisition announcement. The teams agreed to the exchange on February 6."],"verified":"verified","reviewed":"2026-09-08"},{"id":"harden-philadelphia","date":"2022-02-10","order":0,"kind":"trade","title":"Thirteen months later, another exchange.","shortTitle":"Harden joins the Simmons exchange","text":"Harden and Millsap head to Philadelphia. Brooklyn receives Simmons, Curry, Drummond and two first-round obligations.","teams":["BKN","PHI"],"moves":[{"asset":"harden","from":"BKN","to":"PHI"},{"asset":"millsap","from":"BKN","to":"PHI"},{"asset":"simmons-ben","from":"PHI","to":"BKN"},{"asset":"curry-seth","from":"PHI","to":"BKN"},{"asset":"drummond","from":"PHI","to":"BKN"},{"asset":"phi22-harden-defer","from":"PHI","to":"BKN"},{"asset":"phi27-harden","from":"PHI","to":"BKN"}],"conversions":[],"resolutions":[],"sources":["harden22-release","harden22-terms","harden22-recap"],"notes":["The 2022/23 choice is a deferral opt